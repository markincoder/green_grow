# Скопируйте в platform/push/.env (файл в git не попадает).
# Docker Compose на сервере читает agronizer/platform/push/.env.
# Подстановка {SITE_URL} не работает — пишите URL целиком.

DATA_DIR=./data
# Локально SQLite. На проде: mysql+pymysql://user:pass@host:3306/agronizer?charset=utf8mb4
# Если в MySQL URL нет имени БД, создаётся схема agronizer.
DATABASE_URL=sqlite:///./data/access.sqlite
STATIC_DIR=../../site
PORT=3000
VAPID_SUBJECT=mailto:support@agronizer.ru
DEFAULT_APP_URL=/apps/microgreens/
SITE_URL=https://agronizer.ru
SESSION_SECRET=change-me-long-random-string

# Callback URL в кабинетах Яндекса и VK ID — символ в символ, без хвостового слэша.
YANDEX_OAUTH_REDIRECT_URI=https://agronizer.ru/api/auth/oauth/yandex/callback
VK_OAUTH_REDIRECT_URI=https://agronizer.ru/api/auth/oauth/vk/callback
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=

# ЮKassa API v3. Форма: POST /api/pay/{slug} → редирект на оплату.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SUM=300
YOOKASSA_RETURN_URL=https://agronizer.ru/pay/microgreens/
# В кабинете ЮKassa → HTTP-уведомления:
#   URL: https://agronizer.ru/api/pay/notify
#   события: payment.succeeded и payment.canceled

# TRIAL_PERIOD — дни демо с первого запуска приложения (по умолчанию 7).
# PAID_PERIOD — месяцы платного доступа после оплаты (12 = 1 год).
TRIAL_PERIOD=7
PAID_PERIOD=12

# Опционально: защита POST /push/api/send
# PUSH_API_KEY=change-me
